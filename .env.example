# 生产环境变量示例
# 复制为项目根目录的 .env 后会被后端自动读取（已存在的同名环境变量优先，不会被覆盖）。
# 也可以不建 .env，直接在启动命令前设置，例如：PORT=9000 node backend/src/index.js
# 模型接口（Base URL / 模型名 / API Key）在应用「设置」页填写，
# 保存在 data/settings.json，不通过环境变量注入。

# 服务端口（后端同时提供 API 与前端页面）
PORT=8787

# 提示词 token 预算，超出后按优先级裁剪注入区
PROMPT_TOKEN_BUDGET=40000

# 模型调用失败重试（仅对限流 / 5xx / 网络错误在首包前重试）
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_MS=800
LLM_RETRY_MAX_MS=15000
